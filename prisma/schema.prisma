generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  username             String          @unique
  name                 String?
  bio                  String?
  image                String?
  avatarMediaId        String?
  location             String?
  website              String?
  techStack            Json?
  developerLinks       Json?
  role                 UserRole        @default(USER)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  posts                Post[]
  comments             Comment[]
  likes                Like[]
  bookmarks            Bookmark[]
  followers            Follows[]       @relation("following")
  following            Follows[]       @relation("follower")
  notifications        Notifications[] @relation("userNotifications")
  notificationsCreated Notifications[] @relation("NotificationCreator")
  regrids              ReGrid[]
  interests            UserInterest[]
  conversationParticipants ConversationParticipant[]
  sentMessages         DirectMessage[]
  blockedUsers         UserBlock[]     @relation("blocker")
  blockedBy            UserBlock[]     @relation("blocked")
  reportsSent          UserReport[]    @relation("reporter")
  followedTags         TagFollow[]
  solutionsCount       Int             @default(0)
  milestones           DeveloperMilestone[]
}

enum MediaType {
  IMAGE
  VIDEO
}

model Post {
  id            String          @id @default(cuid())
  authorId      String
  content       String?
  mediaUrl      String?
  mediaType     MediaType?
  categoryId    String?
  vibeId        String?
  postType      PostType        @default(STANDARD)
  techContext   Json?
  quotedPostId      String?
  quotedPost        Post?           @relation("QuoteReferences", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotes            Post[]          @relation("QuoteReferences")
  solvedAt          DateTime?
  acceptedAnswerId  String?
  acceptedAnswer    Comment?        @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  author            User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category          Category?       @relation(fields: [categoryId], references: [id])
  vibe              Vibe?           @relation(fields: [vibeId], references: [id])
  tags              PostTag[]
  comments          Comment[]
  likes             Like[]
  bookmarks         Bookmark[]
  notifications     Notifications[]
  regrids           ReGrid[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([quotedPostId])
  @@index([postType, solvedAt])
}

enum PostType {
  STANDARD
  QUOTE
  THREAD_ROOT
  THREAD_REPLY
  QUESTION
  PROJECT_SHIP
}

model Comment {
  id               String          @id @default(cuid())
  content          String
  authorId         String
  postId           String
  parentId         String?
  isSolution       Boolean         @default(false)
  createdAt        DateTime        @default(now())
  author           User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post             Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent           Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[]       @relation("CommentReplies")
  acceptedForPosts Post[]          @relation("AcceptedAnswer")
  notifications    Notifications[]

  @@index([authorId, postId])
  @@index([parentId])
  @@index([postId, isSolution])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, postId])
  @@unique([userId, postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, postId])
  @@unique([userId, postId])
}

model Follows {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId, followingId])
}

model Notifications {
  id         String           @id @default(cuid())
  userId     String
  creatorId  String
  type       NotificationType
  read       Boolean          @default(false)
  postId     String?
  commenttId String?
  createdAt  DateTime         @default(now())
  user       User             @relation("userNotifications", fields: [userId], references: [id], onDelete: Cascade)
  creator    User             @relation("NotificationCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  post       Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment?         @relation(fields: [commenttId], references: [id], onDelete: Cascade)

  @@index([userId, postId])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
}

model Category {
  interests    UserInterest[]
  id    String  @id @default(cuid())
  name  String  @unique
  slug  String  @unique
  emoji String?
  posts Post[]
}

model Vibe {
  id    String  @id @default(cuid())
  key   String  @unique
  label String
  posts Post[]
}

model Tag {
  id             String      @id @default(cuid())
  name           String      @unique
  slug           String      @unique
  followersCount Int         @default(0)
  createdAt      DateTime    @default(now())
  posts          PostTag[]
  followers      TagFollow[]

  @@index([slug])
  @@index([followersCount(sort: Desc)])
}

model TagFollow {
  id        String   @id @default(cuid())
  userId    String
  tagId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([userId])
  @@index([tagId])
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

enum OutboxStatus {
  PENDING
  CLAIMED
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventId       String       @unique
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  occurredAt    DateTime     @default(now())
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  publishedAt   DateTime?
  lastError     String?
  claimedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([createdAt])
  @@index([aggregateId])
  @@index([eventType])
}

model ReGrid {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, postId])
  @@unique([userId, postId])
}


model UserInterest {
  userId     String
  categoryId String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([updatedAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserReport {
  id          String   @id @default(cuid())
  reporterId  String
  targetType  String   // USER | POST | COMMENT
  targetId    String
  reason      String
  description String?
  createdAt   DateTime @default(now())
  reporter    User     @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetType, targetId])
}

model DeveloperMilestone {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String   // RELEASE | OPEN_SOURCE | PROMOTION | AWARD | EDUCATION | OTHER
  icon        String?
  linkUrl     String?
  achievedAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, achievedAt(sort: Desc)])
}


