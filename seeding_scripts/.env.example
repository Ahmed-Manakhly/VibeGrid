# ==============================================================================
# VibeGrid Seeding & Maintenance Environment Configuration
# Copy this file to .env inside seeding_scripts/ and configure your endpoints
# ==============================================================================

# Active Seeding Target (local | prod)
# Default is 'local' unless overridden by CLI flag (e.g. node seeding_scripts/run_all.js prod)
SEED_ENV=local

# Local Development Ingress API Endpoint
LOCAL_API_URL=http://localhost:3000/api

# Production Ingress API Endpoint (Populate in your local .env if targeting remote)
PROD_API_URL=https://your-domain.com/api

# Remote VPS SSH Host for Production Bot Resets (remote_reset_all.sh) & Raw Wipers (raw_db_wipers/remote_wipe_raw_db.sh)
VPS_SSH_HOST=root@your-vps-ip

# Fixed Development / Seeding Bypass OTP (matches FIXED_SEED_OTP in Backend)
SEED_OTP=123456

# Bootstrap Platform Admin Credentials
# MUST match ADMIN_EMAIL & ADMIN_PASSWORD configured in services/auth/.env
ADMIN_EMAIL=admin@vibegrid.manakhly.tech
ADMIN_PASSWORD=your_admin_password_here
