# ─── DATABASE & BROKER CREDENTIALS (Matches VibeGrid_Services/.env) ───
POSTGRES_USER=vibegrid
POSTGRES_PASSWORD=vibegrid_postgres_secret_change_me
POSTGRES_DB=vibegrid_db
REDIS_PASSWORD=vibegrid_redis_secret_change_me

# ─── DEFAULT LOCAL HOST CONNECTIONS (npm run dev on host) ──────────────
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"
REDIS_URL="redis://:${REDIS_PASSWORD}@localhost:6379"
NODE_ENV="development"

# ======================================================================
# 1. LOCAL NATIVE DEV (npm run dev on host — NODE_ENV=development)
# ======================================================================
BASE_API_URL_DEV="http://localhost:8000"
IMG_BASE_SSR_DEV="http://localhost:9000/vibegrid-media/"
IMG_BASE_CSR_DEV="http://localhost:9000/vibegrid-media/"

# ======================================================================
# 2. DOCKER LOCAL DEV (Docker containers — NODE_ENV=docker_development)
# ======================================================================
BASE_API_URL_DOCKER_DEV="http://vibegrid_api_gateway:8000"
IMG_BASE_SSR_DOCKER_DEV="http://vibegrid_minio:9000/vibegrid-media/"
IMG_BASE_CSR_DOCKER_DEV="http://localhost:9000/vibegrid-media/"

# ======================================================================
# 3. PRODUCTION (Deployed Domain Stack — NODE_ENV=production)
# ======================================================================
BASE_API_URL_PROD="http://vibegrid_api_gateway:8000"
IMG_BASE_SSR_PROD="http://vibegrid_minio:9000/vibegrid-media/"
IMG_BASE_CSR_PROD="https://vibegrid.manakhly.tech/vibegrid-media/"

# ======================================================================
# 4. COOKIE TTL CONFIGURATION (Seconds)
# ======================================================================
COOKIE_ACCESS_TOKEN_MAX_AGE_SEC="900"
COOKIE_REFRESH_TOKEN_MAX_AGE_SEC="604800"

# ======================================================================
# 5. JWT RS256 PUBLIC KEY FOR EDGE VERIFICATION
# ======================================================================
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_EXAMPLE_RS256_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
